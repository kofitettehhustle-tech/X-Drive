PORT=3000
MORETHANPANEL_API_KEY=
XDRIVE_MARKUP_PERCENT=
XDRIVE_USE_MOCK_CATALOG=false
XDRIVE_DATABASE_PATH=./data/xdrive.sqlite
# Optional external PostgreSQL URL; when set, the backend prefers Supabase PostgreSQL over local SQLite.
DATABASE_URL=
XDRIVE_ALLOWED_ORIGINS=https://kofitettehhustle-tech.github.io
BASEROW_API_URL=https://api.baserow.io
BASEROW_DATABASE_TOKEN=
BASEROW_TABLE_ID=

# Paystack test checkout. Keep live payments and wallet-funded service orders disabled.
PAYSTACK_SECRET_KEY=
XDRIVE_PAYSTACK_MODE=test
XDRIVE_PAYMENTS_ENABLED=false
XDRIVE_PAYMENT_CURRENCY=USD
XDRIVE_PAYSTACK_CALLBACK_URL=
XDRIVE_DEPOSIT_MIN_MINOR=100
XDRIVE_DEPOSIT_MAX_MINOR=500000
XDRIVE_WALLET_PAYMENTS_ENABLED=false
